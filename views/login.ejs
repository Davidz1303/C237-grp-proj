<%- include('partials/header') %>

<section class="auth-section">
  <div class="auth-card">

    <!-- Brand mark -->
    <div class="auth-brand">✦ DreamStay Hotel</div>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to manage your bookings and profile.</p>

    <!-- Success message shown after registration redirect -->
    <% if (registered) { %>
      <div class="alert alert-success">
        <i class="fas fa-circle-check"></i> Account created! Please sign in.
      </div>
    <% } %>

    <!-- Error message from app.js POST /login -->
    <% if (error) { %>
      <div class="alert alert-error">
        <i class="fas fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <!-- Login form — POSTs to /login in app.js -->
    <form action="/login" method="POST" class="auth-form">

      <div class="form-group">
        <label for="email" class="form-label">Email address</label>
        <div class="input-icon-wrap">
          <i class="fas fa-envelope input-icon"></i>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input input-with-icon"
            placeholder="you@email.com"
            required
            autocomplete="email"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <div class="input-icon-wrap">
          <i class="fas fa-lock input-icon"></i>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input input-with-icon"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          />
          <!-- Toggle password visibility (handled in main.js) -->
          <button type="button" class="password-toggle" id="togglePwd" aria-label="Show password">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">
        <i class="fas fa-right-to-bracket"></i> Sign In
      </button>
    </form>

    <p class="auth-switch">
      Don't have an account? <a href="/register">Create one →</a>
    </p>

    <!-- Hint for demo credentials -->
    <div class="auth-demo-hint">
      <p><strong>Demo accounts:</strong></p>
      <p>Guest — <code>jane@email.com</code> / <code>password</code></p>
      <p>Admin — <code>admin@DreamStay Hotel.com</code> / <code>password</code></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

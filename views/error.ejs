<%- include('partials/header') %>

<section class="auth-section">
  <div class="auth-card error-card">
    <div class="error-icon"><i class="fas fa-triangle-exclamation"></i></div>
    <h1 class="error-title">Oops!</h1>
    <p class="error-message"><%= message || 'Something went wrong.' %></p>
    <div class="error-actions">
      <a href="/"         class="btn btn-primary">Go Home</a>
      <a href="javascript:history.back()" class="btn btn-ghost">Go Back</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

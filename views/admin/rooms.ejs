<%- include('../partials/header') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar-brand">✦ Admin Panel</div>
    <nav class="admin-nav">
      <a href="/admin"          class="admin-nav-link"><i class="fas fa-gauge"></i> Dashboard</a>
      <a href="/admin/rooms"    class="admin-nav-link active"><i class="fas fa-bed"></i> Rooms</a>
      <a href="/admin/bookings" class="admin-nav-link"><i class="fas fa-calendar-check"></i> Bookings</a>
      <a href="/admin/users"    class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
      <hr class="admin-nav-divider" />
      <a href="/"       class="admin-nav-link"><i class="fas fa-globe"></i> View Site</a>
      <a href="/logout" class="admin-nav-link"><i class="fas fa-right-from-bracket"></i> Logout</a>
    </nav>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">Manage Rooms</h1>
      <a href="/admin/rooms/add" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Room
      </a>
    </div>

    <!-- Success flash from redirect query string -->
    <% if (success) { %>
      <div class="alert alert-success">
        <% if (success === 'added')   { %>Room added successfully.<% } %>
        <% if (success === 'updated') { %>Room updated successfully.<% } %>
        <% if (success === 'deleted') { %>Room deleted.<% } %>
      </div>
    <% } %>

    <!-- ── ROOMS TABLE ─────────────────────────────────── -->
    <div class="admin-card">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Room Name</th>
              <th>Type</th>
              <th>Price/Night</th>
              <th>Capacity</th>
              <th>Available</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rooms.forEach(room => { %>
              <tr>
                <td>
                  <img
                    src="<%= room.image_url || '/images/room-placeholder.jpg' %>"
                    alt="<%= room.room_name %>"
                    class="admin-room-thumb"
                  />
                </td>
                <td><strong><%= room.room_name %></strong></td>
                <td><span class="room-type-badge badge-<%= room.room_type.toLowerCase() %>"><%= room.room_type %></span></td>
                <td>SGD <%= Number(room.price_per_night).toFixed(2) %></td>
                <td><i class="fas fa-user"></i> <%= room.capacity %></td>
                <td>
                  <!-- Green tick / red cross for availability -->
                  <% if (room.is_available) { %>
                    <span class="text-green"><i class="fas fa-circle-check"></i> Yes</span>
                  <% } else { %>
                    <span class="text-red"><i class="fas fa-ban"></i> No</span>
                  <% } %>
                </td>
                <td class="table-actions">
                  <!-- Edit button links to admin room form pre-filled with this room's data -->
                  <a href="/admin/rooms/edit/<%= room.id %>" class="btn btn-ghost btn-xs">
                    <i class="fas fa-pen"></i> Edit
                  </a>
                  <!-- Delete triggers app.js POST /admin/rooms/delete/:id -->
                  <form action="/admin/rooms/delete/<%= room.id %>" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-danger btn-xs"
                      onclick="return confirm('Delete <%= room.room_name %>? This also removes all related bookings and reviews.')">
                      <i class="fas fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

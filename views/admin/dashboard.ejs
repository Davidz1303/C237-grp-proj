<%- include('../partials/header') %>

<div class="admin-layout">

  <!-- ── ADMIN SIDEBAR ────────────────────────────────── -->
  <aside class="admin-sidebar">
    <div class="admin-sidebar-brand">✦ Admin Panel</div>
    <nav class="admin-nav">
      <a href="/admin"          class="admin-nav-link active"><i class="fas fa-gauge"></i> Dashboard</a>
      <a href="/admin/rooms"    class="admin-nav-link"><i class="fas fa-bed"></i> Rooms</a>
      <a href="/admin/bookings" class="admin-nav-link"><i class="fas fa-calendar-check"></i> Bookings</a>
      <a href="/admin/users"    class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
      <hr class="admin-nav-divider" />
      <a href="/"       class="admin-nav-link"><i class="fas fa-globe"></i> View Site</a>
      <a href="/logout" class="admin-nav-link"><i class="fas fa-right-from-bracket"></i> Logout</a>
    </nav>
  </aside>

  <!-- ── ADMIN MAIN CONTENT ────────────────────────────── -->
  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">Dashboard Overview</h1>
      <span class="admin-greeting">Signed in as <strong><%= user.full_name %></strong></span>
    </div>

    <!-- ── STAT CARDS ─────────────────────────────────── -->
    <!-- Stats are fetched via COUNT() queries in app.js GET /admin -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card stat-blue">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalUsers %></span>
          <span class="stat-name">Registered Users</span>
        </div>
      </div>
      <div class="admin-stat-card stat-green">
        <div class="stat-icon"><i class="fas fa-bed"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalRooms %></span>
          <span class="stat-name">Total Rooms</span>
        </div>
      </div>
      <div class="admin-stat-card stat-orange">
        <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= totalBookings %></span>
          <span class="stat-name">All Bookings</span>
        </div>
      </div>
      <div class="admin-stat-card stat-purple">
        <div class="stat-icon"><i class="fas fa-dollar-sign"></i></div>
        <div class="stat-info">
          <span class="stat-value">SGD <%= Number(revenue).toLocaleString() %></span>
          <span class="stat-name">Confirmed Revenue</span>
        </div>
      </div>
    </div>

    <!-- ── RECENT BOOKINGS TABLE ───────────────────────── -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">Recent Bookings</h2>
        <a href="/admin/bookings" class="btn btn-ghost btn-sm">View All →</a>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Guest</th>
              <th>Room</th>
              <th>Check-in</th>
              <th>Check-out</th>
              <th>Total</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% recentBookings.forEach(b => { %>
              <tr>
                <td><%= b.full_name %><br/><small class="text-muted"><%= b.email %></small></td>
                <td><%= b.room_name %></td>
                <td><%= new Date(b.check_in).toLocaleDateString('en-SG', {day:'2-digit', month:'short'}) %></td>
                <td><%= new Date(b.check_out).toLocaleDateString('en-SG', {day:'2-digit', month:'short'}) %></td>
                <td>SGD <%= Number(b.total_price).toFixed(2) %></td>
                <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── QUICK LINKS ─────────────────────────────────── -->
    <div class="admin-quick-links">
      <a href="/admin/rooms/add" class="admin-quick-card">
        <i class="fas fa-plus-circle"></i>
        <span>Add New Room</span>
      </a>
      <a href="/admin/bookings" class="admin-quick-card">
        <i class="fas fa-clipboard-list"></i>
        <span>Manage Bookings</span>
      </a>
      <a href="/admin/users" class="admin-quick-card">
        <i class="fas fa-user-gear"></i>
        <span>Manage Users</span>
      </a>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

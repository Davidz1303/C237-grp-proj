<%- include('../partials/header') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar-brand">✦ Admin Panel</div>
    <nav class="admin-nav">
      <a href="/admin"          class="admin-nav-link"><i class="fas fa-gauge"></i> Dashboard</a>
      <a href="/admin/rooms"    class="admin-nav-link"><i class="fas fa-bed"></i> Rooms</a>
      <a href="/admin/bookings" class="admin-nav-link"><i class="fas fa-calendar-check"></i> Bookings</a>
      <a href="/admin/users"    class="admin-nav-link active"><i class="fas fa-users"></i> Users</a>
      <hr class="admin-nav-divider" />
      <a href="/"       class="admin-nav-link"><i class="fas fa-globe"></i> View Site</a>
      <a href="/logout" class="admin-nav-link"><i class="fas fa-right-from-bracket"></i> Logout</a>
    </nav>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">Manage Users</h1>
    </div>

    <!-- User search form — GET /admin/users?search=… -->
    <form class="filter-bar filter-bar-compact" method="GET" action="/admin/users">
      <div class="filter-group filter-search">
        <i class="fas fa-magnifying-glass input-icon" style="position:static;margin-right:8px;"></i>
        <input
          type="text"
          name="search"
          class="filter-input"
          placeholder="Search by name or email…"
          value="<%= search %>"
        />
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
      <% if (search) { %>
        <a href="/admin/users" class="btn btn-ghost btn-sm">Clear</a>
      <% } %>
    </form>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        <% if (success === 'role_changed') { %>User role updated.<% } %>
        <% if (success === 'deleted') { %>User deleted.<% } %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error === 'self') { %>
      <div class="alert alert-warning">You cannot modify your own account from here.</div>
    <% } %>

    <div class="admin-card">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Role</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted">No users found.</td></tr>
            <% } %>
            <% users.forEach(u => { %>
              <tr>
                <td class="text-muted">#<%= u.id %></td>
                <td><strong><%= u.full_name %></strong></td>
                <td><%= u.email %></td>
                <td><%= u.phone || '—' %></td>
                <td>
                  <!-- Role badge coloured differently for admin vs guest -->
                  <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
                </td>
                <td><%= new Date(u.created_at).toLocaleDateString('en-SG', {day:'2-digit', month:'short', year:'numeric'}) %></td>
                <td class="table-actions">
                  <!--
                    Toggle role: POST /admin/users/role/:id
                    The server flips the current role (admin ↔ guest)
                  -->
                  <% if (u.id !== user.id) { %>
                    <form action="/admin/users/role/<%= u.id %>" method="POST" style="display:inline">
                      <button type="submit" class="btn btn-ghost btn-xs"
                        onclick="return confirm('Change role of <%= u.full_name %>?')">
                        <i class="fas fa-arrow-right-arrow-left"></i>
                        <%= u.role === 'admin' ? 'Make Guest' : 'Make Admin' %>
                      </button>
                    </form>

                    <!-- Delete user and all their data -->
                    <form action="/admin/users/delete/<%= u.id %>" method="POST" style="display:inline">
                      <button type="submit" class="btn btn-danger btn-xs"
                        onclick="return confirm('Delete <%= u.full_name %>? This will remove all their bookings and reviews.')">
                        <i class="fas fa-trash-can"></i>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">(you)</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>

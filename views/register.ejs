<%- include('partials/header') %>

<section class="auth-section">
  <div class="auth-card">

    <div class="auth-brand">✦ DreamStay Hotel</div>
    <h1 class="auth-title">Create your account</h1>
    <p class="auth-subtitle">Join DreamStay Hotel for exclusive member rates and easy booking management.</p>

    <!-- Error message from POST /register in app.js -->
    <% if (error) { %>
      <div class="alert alert-error">
        <i class="fas fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <!-- Registration form — POSTs to /register in app.js -->
    <form action="/register" method="POST" class="auth-form">

      <div class="form-group">
        <label for="full_name" class="form-label">Full Name</label>
        <div class="input-icon-wrap">
          <i class="fas fa-user input-icon"></i>
          <input
            type="text"
            id="full_name"
            name="full_name"
            class="form-input input-with-icon"
            placeholder="Jane Tan"
            required
            autocomplete="name"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <div class="input-icon-wrap">
          <i class="fas fa-envelope input-icon"></i>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input input-with-icon"
            placeholder="jane@email.com"
            required
            autocomplete="email"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">Phone Number <span class="optional">(optional)</span></label>
        <div class="input-icon-wrap">
          <i class="fas fa-phone input-icon"></i>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="form-input input-with-icon"
            placeholder="+65 9000 0000"
            autocomplete="tel"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <div class="input-icon-wrap">
          <i class="fas fa-lock input-icon"></i>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input input-with-icon"
            placeholder="Min. 8 characters"
            required
            minlength="6"
            autocomplete="new-password"
          />
          <button type="button" class="password-toggle" id="togglePwd" aria-label="Show password">
            <i class="fas fa-eye"></i>
          </button>
        </div>
        <!-- Live password strength indicator (JS in main.js) -->
        <div class="password-strength" id="pwStrength">
          <div class="strength-bar" id="strengthBar"></div>
        </div>
        <p class="strength-label" id="strengthLabel"></p>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">
        <i class="fas fa-user-plus"></i> Create Account
      </button>
    </form>

    <p class="auth-switch">
      Already have an account? <a href="/login">Sign in →</a>
    </p>
  </div>
</section>

<%- include('partials/footer') %>
